{
  "name": "fullstack-website",
  "version": "1.0.0",
  "description": "A full-stack website using Node.js and React",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "cd frontend && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-client": "cd frontend && npm install",
    "install-server": "npm install",
    "build-client": "cd frontend && npm run build",
    "build": "npm run install-server && npm run install-client && npm run build-client",
    "heroku-postbuild": "npm run install-client && npm run build-client",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "setup-db": "node src/scripts/setup-database.js"
  },
  "keywords": [
    "nodejs",
    "react",
    "fullstack"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mui/lab": "^6.0.0-beta.31",
    "@supabase/supabase-js": "^2.29.0",
    "axios": "^1.6.1",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^9.4.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.1",
    "pdfkit": "^0.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "stripe": "^14.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
